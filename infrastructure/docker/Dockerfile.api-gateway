FROM rust:1.75-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Cargo files
COPY Cargo.toml Cargo.lock ./
COPY services/api-gateway/Cargo.toml ./services/api-gateway/
COPY crates/ ./crates/

# Create dummy source files to cache dependencies
RUN mkdir -p services/api-gateway/src crates/*/src
RUN echo "fn main() {}" > services/api-gateway/src/main.rs
RUN find crates -name src -type d -exec sh -c 'echo "fn main() {}" > "$1/lib.rs"' _ {} \;

# Build dependencies
RUN cargo build --release --package api-gateway
RUN rm services/api-gateway/src/main.rs
RUN find crates -name lib.rs -delete

# Copy actual source code
COPY services/api-gateway/src ./services/api-gateway/src
COPY crates/src ./crates/

# Build the application
RUN cargo build --release --package api-gateway

# Runtime image
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the binary
COPY --from=builder /app/target/release/api-gateway /usr/local/bin/

# Create non-root user
RUN useradd -r -s /bin/false appuser
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080

CMD ["api-gateway"]
