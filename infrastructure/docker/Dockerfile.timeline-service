FROM rust:1.75-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Cargo files
COPY Cargo.toml Cargo.lock ./
COPY services/timeline-service/Cargo.toml ./services/timeline-service/
COPY crates/ ./crates/

# Create dummy source files to cache dependencies
RUN mkdir -p services/timeline-service/src crates/*/src
RUN echo "fn main() {}" > services/timeline-service/src/main.rs
RUN find crates -name src -type d -exec sh -c 'echo "fn main() {}" > "$1/lib.rs"' _ {} \;

# Build dependencies
RUN cargo build --release --package timeline-service
RUN rm services/timeline-service/src/main.rs
RUN find crates -name lib.rs -delete

# Copy actual source code
COPY services/timeline-service/src ./services/timeline-service/src
COPY crates/src ./crates/

# Build the application
RUN cargo build --release --package timeline-service

# Runtime image
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the binary
COPY --from=builder /app/target/release/timeline-service /usr/local/bin/

# Create non-root user
RUN useradd -r -s /bin/false appuser
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

EXPOSE 8081

CMD ["timeline-service"]
